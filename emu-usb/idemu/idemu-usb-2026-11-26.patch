diff --git a/idemu/usb/start.sh b/idemu/usb/start.sh
new file mode 100644
index 0000000..c1fae5f
--- /dev/null
+++ b/idemu/usb/start.sh
@@ -0,0 +1,21 @@
+#!/bin/ksh
+# local addition (bmw-id6-apps): the firmware's own USB host stack on the OMAP5 high-speed host (EHCI + OHCI companion),
+# for environments with USB on ("usb": true, or the server started with IDEMU_USB=1; QEMU then has the EHCI model).
+# Same driver and arguments as the car's /bin/start_usb.sh, without the omap5-xhci part (not modelled; see omap5-uevm.c).
+# A host device (an iPhone passed through from the Mac) shows up on /dev/io-usb/io-usb, as the car's devices do.
+# Log: /dev/shmem/usb.log
+L=/dev/shmem/usb.log
+R=/fs/sda0/repository/istep
+export LD_LIBRARY_PATH=$R/lib:$R/lib/dll:/lib:/lib/dll:/usr/lib:/opt/sys/lib
+echo "usb: starting io-usb (EHCI 0x4a064c00 irq 109)" > $L
+# The car's /tmp is a link to the RAM disk /fs/ram5; IDEmu has the link but no disk. A folder on /var (reset at every
+# IDEmu boot) stands in for it, so programs that work in /tmp (nbt_carplay) behave as on the car.
+[ -d /fs/ram5 ] || { mkdir -p /var/ram5 && ln -sP /var/ram5 /fs/ram5 && echo "usb: /fs/ram5 -> /var/ram5 (car-like /tmp)" >> $L; }
+$R/bin/io-usb -c -vvv -d hb-ehci-omap3 ioport=0x4a064c00,irq=109,verbose=5,num_itd=256,portd >> $L 2>&1 &
+n=0
+while [ ! -e /dev/io-usb/io-usb ] && [ $n -lt 20 ]; do sleep 1; n=$((n + 1)); done
+if [ ! -e /dev/io-usb/io-usb ]; then echo "usb: no /dev/io-usb/io-usb after 20 s" >> $L; exit 1; fi
+echo "usb: /dev/io-usb/io-usb after $n s" >> $L
+sleep 3
+$R/bin/usb >> $L 2>&1
+echo "usb: ready" >> $L
