diff --git a/src/qemu/omap5-uevm.c b/src/qemu/omap5-uevm.c
index 415cb3f..b597297 100644
--- a/src/qemu/omap5-uevm.c
+++ b/src/qemu/omap5-uevm.c
@@ -23,6 +23,8 @@
 #include "hw/core/cpu.h"
 #include "hw/display/omap5430_dss.h"   /* local addition (bmw-id6-apps): DSS/DMA from bimmulator, GPL-2.0-or-later */
 #include "hw/dma/omap5430_sdma.h"
+#include "hw/usb/hcd-ehci.h"          /* local addition (bmw-id6-apps): OMAP5 USB host, IDEMU_USB=1 */
+#include "hw/usb/hcd-ohci.h"
 #include "monitor/qdev.h"
 #include <sys/socket.h>
 #include <sys/un.h>
@@ -353,6 +355,26 @@ static void omap5_uevm_init(MachineState *machine)
         }
     }
 
+    /* local addition (bmw-id6-apps): IDEMU_USB=1 adds the OMAP5 high-speed USB host that the firmware's own io-usb
+     * drives with devu-hb-ehci-omap3.so: EHCI at 0x4a064c00 (SPI 77 = OMAP irq 109) and its OHCI companion at
+     * 0x4a064800 (SPI 76), as in bimmulator's OMAP5430 board. The EHCI has id "ehci", so a host device goes on its bus
+     * with -device usb-host,bus=ehci.0,... (IDEMU_QEMU_EXTRA). The OMAP5 xHCI (DWC3, the car's console USB port) is not
+     * modelled: QNX's omap5-xhci driver does not run on QEMU's generic xHCI (bimmulator saw it crash in evtring_create).
+     * Off by default: the plain IDEmu board is unchanged. */
+    if (getenv("IDEMU_USB")) {
+        DeviceState *ehci = qdev_new(TYPE_PLATFORM_EHCI);
+        DeviceState *ohci = qdev_new(TYPE_SYSBUS_OHCI);
+        qdev_set_id(ehci, g_strdup("ehci"), &error_fatal);
+        object_property_set_bool(OBJECT(ehci), "companion-enable", true, &error_fatal);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(ehci), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(ehci), 0, 0x4a064c00);
+        sysbus_connect_irq(SYS_BUS_DEVICE(ehci), 0, pic[77]);
+        object_property_set_str(OBJECT(ohci), "masterbus", SYS_BUS_EHCI(ehci)->ehci.bus.qbus.name, &error_fatal);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(ohci), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(ohci), 0, 0x4a064800);
+        sysbus_connect_irq(SYS_BUS_DEVICE(ohci), 0, pic[76]);
+    }
+
     /* UART3 (console) 16550, regshift 2, SPI 106 */
     serial_mm_init(sysmem, 0x48020000, 2, pic[74], 48000000 / 16,
                    serial_hd(0), DEVICE_LITTLE_ENDIAN);
